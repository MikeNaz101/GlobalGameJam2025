      objectReference: {fileID: 0}
    - target: {fileID: 5244568340785563921, guid: 4395ae371e1c8184989acbb800f29f69, type: 3}
      propertyPath: 'tutorialMessages.Array.data[6]'
      value: That is a sacred tree!. They will heal you if yo are low on health.
